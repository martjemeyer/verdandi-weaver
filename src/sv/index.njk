    </div>

    <span class="growing-divider"></span>

    <div class="center-text">
      <p class="t-eyebrow">Följ med</p>
      <h3 class="t-h3" style="margin-top: var(--sp-2);">Hitta arbetet där du redan lyssnar, tittar, läser eller samlas.</h3>
      <div class="social-row" style="margin-top: var(--sp-6);">
        {% set svDescriptors = {
          substack: "Podcast och reflektioner",
          youtube: "Filmer och samtal",
          instagram: "Bilder och kortare reflektioner",
