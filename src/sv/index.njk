          patreon: "Medlemskap och butik"
        } %}
        {% for p in socialPlatforms %}
        <a class="social-row__item" href="{{ p.url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ p.name }} — {{ svDescriptors[p.key] or p.descriptor }} (öppnas i en ny flik)">
          <span class="social-row__icon">{{ icon(p.icon) }}</span>
          <span class="social-row__text">
            <span class="social-row__name">{{ p.name }}</span>
            <span class="social-row__descriptor">{{ svDescriptors[p.key] or p.descriptor }}</span>
          </span>
        </a>
        {% endfor %}
      </div>
    </div>

    <span class="growing-divider"></span>

    <div class="center-text">
      <p class="t-eyebrow">Hjälp arbetet fortsätta</p>
      <h3 class="t-h3" style="margin-top: var(--sp-2);">Verdandi Weaver skapas oberoende</h3>
      <p class="t-body t-pretty" style="max-width: 60ch; margin: var(--sp-3) auto 0;">Stöd hjälper till att skapa utrymme för nya poddavsnitt, filmer, böcker, reflektionsverktyg, översättningar, undertexter, Rethinking Society-resurser och framtida onlinesamlingar.</p>
      <div class="grid grid-3" style="margin-top: var(--sp-7); text-align: left;">
        {% set svSupport = {
          buyMeACoffee: { description: "Ge ett litet engångsbidrag eller utforska nedladdningsbara resurser.", buttonText: "Stöd via Buy Me a Coffee" },
          goFundMe: { description: "Hjälp till att finansiera Verdandi Weavers och Rethinking Societys fortsatta växt.", buttonText: "Besök GoFundMe" },
          patreon: { description: "Gå med, följ uppdateringar, eller utforska medlemskap och resursbutiken.", buttonText: "Utforska Patreon" }
        } %}
        {% for s in supportPlatforms %}
        <div>
          <span class="support-card__icon">{{ icon(s.icon) }}</span>
          <h4 class="t-h4" style="margin-top: var(--sp-3);">{{ s.name }}</h4>
          <p class="t-body t-pretty" style="margin-top: var(--sp-2);">{{ svSupport[s.key].description or s.description }}</p>
          <a class="btn btn--ghost" href="{{ s.url }}" target="_blank" rel="noopener noreferrer" style="margin-top: var(--sp-4);">{{ svSupport[s.key].buttonText or s.buttonText }}</a>
        </div>
        {% endfor %}
      </div>
    </div>

  </div>
</section>

