{% block extraScripts %}
<script>
  (function(){
    const hub = document.querySelector('[data-hub]');
    if (!hub) return;
    const threads = hub.querySelectorAll('.thread');
    const nodes = hub.querySelectorAll('.hub__node');
    nodes.forEach(node => {
      const id = node.dataset.id;
      node.addEventListener('mouseenter', () => {
        threads.forEach(t => {
          const related = t.dataset.a === id || t.dataset.b === id;
          t.style.opacity = related ? 1 : 0.12;
          t.setAttribute('stroke-width', related ? '1.4' : '0.6');
        });
      });
      node.addEventListener('mouseleave', () => {
        threads.forEach(t => { t.style.opacity = ''; t.removeAttribute('stroke-width'); });
      });
    });
  })();
</script>
{% endblock %}
