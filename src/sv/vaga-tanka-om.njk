---
layout: layouts/base.njk
title: Våga Tänka Om med Verdandi Weaver | Podcast
description: En podcast om livet, människan och världen vi skapar tillsammans. Avsnitt, samtalsfrågor och material för dig som vill tänka vidare med andra.
permalink: /sv/vaga-tanka-om/index.html
navSection: vaga-tanka-om
pageLang: sv
translationUrl: /rethinking-everything/
canonical: https://verdandiweaver.com/sv/vaga-tanka-om/
hreflangAlternates:
  en: https://verdandiweaver.com/rethinking-everything/
  sv: https://verdandiweaver.com/sv/vaga-tanka-om/
  x-default: https://verdandiweaver.com/rethinking-everything/
ogTitle: Våga Tänka Om med Verdandi Weaver | Podcast
ogDescription: En podcast om livet, människan och världen vi skapar tillsammans.
---
{% from "social-icons.njk" import icon %}
{% set show = podcastShows | byShowKey("vagaTanka") %}

<div class="rs">

<section class="hero container fade-up">
  <p class="t-eyebrow hero__eyebrow">Podcast</p>
  <h1 class="t-h1 hero__title t-balance">{{ show.fullName }}</h1>
  <p class="t-lead hero__lead t-pretty">{{ show.byline }}</p>
  <p class="t-body t-pretty" style="margin-top: var(--sp-4);">{{ show.invitation }}</p>
</section>

{#- Episode data is fetched client-side (assets/podcast-feed.js) — see
   .eleventy.js for why. This fallback is the real initial content;
   the script replaces it with the live newest episode when the fetch
   succeeds (config below tells it which feed and what to say). #}
<section class="section section--sunk fade-up">
  <div class="container narrow" id="podcast-hub-latest">
    <div class="center-text">
      <p class="t-body">Nya avsnitt finns på Substack.</p>
      <a class="btn btn--ghost" href="{{ show.sectionUrl }}" target="_blank" rel="noopener noreferrer" style="margin-top: var(--sp-4);">Besök på Substack</a>
    </div>
  </div>
</section>

<section class="section fade-up">
  <div class="container narrow center-text">
    <header class="section-header">
      <h2 class="t-h2 t-balance">Lyssna på ditt sätt</h2>
    </header>
    <div class="social-row" style="justify-content:center;">
      {% if show.sectionUrl %}<a class="social-row__item" href="{{ show.sectionUrl }}" target="_blank" rel="noopener noreferrer"><span class="social-row__icon">{{ icon("substack") }}</span><span class="social-row__text">Läs och lyssna på Substack</span></a>{% endif %}
      {% if show.spotify %}<a class="social-row__item" href="{{ show.spotify }}" target="_blank" rel="noopener noreferrer"><span class="social-row__icon">{{ icon("spotify") }}</span><span class="social-row__text">Lyssna på Spotify</span></a>{% endif %}
      {% if show.apple %}<a class="social-row__item" href="{{ show.apple }}" target="_blank" rel="noopener noreferrer"><span class="social-row__icon">{{ icon("apple") }}</span><span class="social-row__text">Lyssna på Apple Podcasts</span></a>{% endif %}
      {% if show.youtubeMusic %}<a class="social-row__item" href="{{ show.youtubeMusic }}" target="_blank" rel="noopener noreferrer"><span class="social-row__icon">{{ icon("youtube") }}</span><span class="social-row__text">Lyssna på YouTube Music</span></a>{% endif %}
      {% if show.facebook %}<a class="social-row__item" href="{{ show.facebook }}" target="_blank" rel="noopener noreferrer"><span class="social-row__icon">{{ icon("facebook") }}</span><span class="social-row__text">Följ Våga Tänka Om på Facebook</span></a>{% endif %}
    </div>
  </div>
</section>

{#- Filled in by assets/podcast-feed.js if the show has more than one
   episode; stays hidden and empty otherwise. #}
<section class="section section--sunk fade-up">
  <div class="container" id="podcast-hub-episodes" hidden></div>
</section>

<section class="section fade-up">
  <div class="container narrow center-text">
    <header class="section-header">
      <h2 class="t-h2 t-balance">Ta samtalet vidare</h2>
    </header>
    <p class="t-body t-pretty">Till varje avsnitt finns – eller kommer efter hand – material för dig som vill fördjupa frågorna och fortsätta samtalet tillsammans med andra.</p>
    <a class="btn btn--ghost" href="/sv/rethinking-society/gathering-library/" style="margin-top: var(--sp-4);">Besök Samlingsbiblioteket</a>
  </div>
</section>

<section class="section section--sunk fade-up">
  <div class="container narrow center-text">
    <header class="section-header">
      <h2 class="t-h2 t-balance">Stöd arbetet</h2>
    </header>
    <p class="t-body t-pretty">Lyssna fritt. Dela fritt. Fördjupa dig om du vill. Stöd arbetet om du kan.</p>
    <a class="btn btn--accent" href="/sv/rethinking-society/support/" style="margin-top: var(--sp-4);">Stöd arbetet</a>
  </div>
</section>

<section class="section fade-up">
  <div class="container narrow center-text">
    <p class="t-lead t-pretty"><em>{{ show.closingQuestion }}</em></p>
  </div>
</section>

</div>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "PodcastSeries",
  "name": "{{ show.fullName }}",
  "description": "{{ show.byline }}",
  "url": "https://verdandiweaver.com/sv/vaga-tanka-om/",
  "inLanguage": "sv"
}
</script>

{% block extraScripts %}
<script>
  window.VW_PODCAST_HUB = {
    key: "vagaTanka",
    strings: {
      latestEpisode: "Senaste avsnittet",
      listenTo: "Lyssna på",
      noAudioSupport: "Din webbläsare stödjer inte ljudspelaren.",
      readOnSubstack: "Läs och lyssna på Substack",
      listenOnSubstack: "Lyssna på Substack",
      allEpisodes: "Alla avsnitt"
    }
  };
</script>
{% endblock %}
